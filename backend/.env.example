# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hcm-lite
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hcm-lite

# Groq Cloud SDK API Key (get from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=gsk_your_groq_api_key_here

# JWT Secret Tokens
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production

# Token Expiry Durations
ACCESS_TOKEN_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d
